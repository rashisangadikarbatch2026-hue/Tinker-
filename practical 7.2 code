int Led = 13;
int pb = 2;
int buzz = 8;

void setup()
{
  pinMode(Led, OUTPUT);
  pinMode(pb, INPUT_PULLUP);
  pinMode(buzz, OUTPUT);
}

void loop()
{
  int buttonstate = digitalRead(pb);

  if (buttonstate == HIGH) {
    digitalWrite(Led, HIGH);
    noTone(buzz);
  }
  else {
    digitalWrite(Led, LOW);
    tone(buzz, 1200, 400);
  }
}
